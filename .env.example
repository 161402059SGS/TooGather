# ---------------------------------------------------------------------------
# TooGather configuration. Copy to .env and edit.  NEVER commit your .env file.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# CHANGE: database password (any long random string).
POSTGRES_PASSWORD=change-me

# Signs sessions, and encrypts the API keys and connector tokens stored in the
# database. Leave it empty and one is generated on first start and kept in the
# /data volume; set it only when several machines serve the same install.
#
# Changing it signs everyone out AND makes stored keys unreadable, so they have
# to be entered again. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How teammates reach this server, e.g. http://192.168.1.50:8080
# Used for links in the weekly digest and the MCP setup example.
BASE_URL=http://localhost:8080

# The team's time zone. Decides when a commitment counts as overdue.
TIMEZONE=Asia/Jakarta

# Set to true only when TooGather is served over HTTPS.
COOKIE_SECURE=false

# --- AI extraction (optional) ---------------------------------------------
# Leave LLM_BASE_URL empty to run without AI. Uploads are then stored and
# events are added by hand. AI must also be switched on per project.
#
# This is the server default. A project can point at a different endpoint and
# model under its own Settings - useful when one client's contract forbids
# cloud AI - and that project's API key is stored encrypted in the database.
#
# Any OpenAI-compatible endpoint works. Examples:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     LLM_BASE_URL=http://host.docker.internal:11434/v1   (fully local, no API key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_INPUT_CHARS=12000

# --- Weekly digest by email (optional) ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
DIGEST_INTERVAL_DAYS=7

# --- Drift rules ------------------------------------------------------------
STALE_QUESTION_DAYS=14
STALE_PROPOSAL_DAYS=3

# --- Connectors (optional) --------------------------------------------------
# A connector pulls material into a project on a schedule - commits from a Git
# repository, for instance. They are set up per project by its owner; this
# switch turns the whole mechanism off for the server, whatever any project
# has configured.
CONNECTORS_ENABLED=true

# How long one connector run may take before it is given up on. A first clone
# of a large repository is the slow case.
CONNECTOR_TIMEOUT_SECONDS=300

# Where TooGather keeps what it writes to disk: the generated SECRET_KEY and
# the Git connector's repository mirrors. In Docker this is a volume; leave it
# alone unless you are running without Docker.
TOOGATHER_DATA_DIR=/data
